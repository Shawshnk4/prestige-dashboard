# Copy to .env only for running on your own machine. Never commit real values. On Render, set these in Environment.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
ALLOWED_EMAILS=you@firm.com,colleague@firm.com
FYERS_CLIENT_ID=<APPID>-100
FYERS_SECRET_KEY=<app secret>
FYERS_REDIRECT_URI=https://www.google.com/
FYERS_FY_ID=<your FYERS client id>
FYERS_PIN=<4-digit PIN>
FYERS_TOTP_KEY=<TOTP secret from FYERS external 2FA setup>
CRON_SECRET=<any long random string>
